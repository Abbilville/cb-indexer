# HTTP Port for the Streamable MCP Server & Daemon (Default: 43770)
PORT=43770

# Secret token / API key for securing HTTP MCP endpoints.
# If set, incoming requests must supply "Authorization: Bearer <token>" or "X-API-Key: <token>".
# Leave empty to disable authentication (e.g. for local-only development).
OSS_INDEXER_AUTH_TOKEN=

# Optional custom path for the machine-wide projects catalog.
# Default: ~/.config/oss-mcp/projects.yaml
# MCP_PROJECTS_CATALOG=

# Optional fallback path to a custom registry.yaml file.
# Default: auto-discovered from current workspace or ~/.config/oss-mcp/projects.yaml
# MCP_REGISTRY_PATH=
